/ {
	chosen {
        zephyr,console = &cdc_acm_uart0;
    };

    leds {
        compatible = "gpio-leds";
        synth_led0: led_0 {
                gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>;
        };
        synth_led1: led_1 {
                gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
        };
        synth_led2: led_2 {
                gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
        };
        synth_led3: led_3 {
                gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
        };
        synth_led4: led_4 {
                gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
        };
        board_led0: led_5 {
            gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>;
        };
        board_led1: led_6 {
            gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
        };
        board_led2: led_7 {
            gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
        };
        board_led3: led_8 {
            gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
        };
    };
    buttons {
        compatible = "gpio-keys";
        button: button {
            gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
        };
        switch0: button_0 {
            gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
        };
        switch1: button_1 {
            gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;
        };
        switch2: button_2 {
            gpios = <&gpioe 10 GPIO_ACTIVE_HIGH>;
        };
        switch3: button_3 {
            gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
        };
        switch4: button_4 {
            gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
        };
        switch5: button_5 {
            gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
        };
        switch6: button_6 {
            gpios = <&gpioe 14 GPIO_ACTIVE_HIGH>;
        };
        switch7: button_7 {
            gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
        };
    };

    aliases {
        switch0 = &switch0;
        switch1 = &switch1;
        switch2 = &switch2;
        switch3 = &switch3;
        switch4 = &switch4;
        switch5 = &switch5;
        switch6 = &switch6;
        switch7 = &switch7;
    };

};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&i2c1 {
    pinctrl-0 = <&i2c1_sda_pb9 &i2c1_scl_pb6>;
    pinctrl-names = "default";
    status = "okay";
};
